############################################################
# Environment Variables for My Grocery App
# Copy this file to .env.local and fill in your values
#
# WARNING: DO NOT COMMIT REAL SECRETS TO VERSION CONTROL!
# Set all values below in your deployment environment.
############################################################

# Vite Environment Variables (Recommended - used by Vite build)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Legacy React App Environment Variables (for backward compatibility)
# These are only used if VITE_ variables are not set
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
REACT_APP_FIREBASE_MEASUREMENT_ID=

# Production Settings
NODE_ENV=production
PORT=3000
