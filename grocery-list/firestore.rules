rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the resource
    function isOwner(ownerId) {
      return isAuthenticated() && request.auth.uid == ownerId;
    }
    
    // Helper function to check if user is in allowedUsers array
    function isAllowedUser(allowedUsers) {
      return isAuthenticated() && request.auth.uid in allowedUsers;
    }
    
    // Helper function to validate string length
    function isValidString(value, minLength, maxLength) {
      return value is string && value.size() >= minLength && value.size() <= maxLength;
    }
    
    // Users collection - stores user profiles
    match /users/{userId} {
      // Users can only read/write their own profile
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if false; // Prevent user deletion via client
    }
    
    // Lists collection - grocery lists
    match /lists/{listId} {
      // Allow read if user is owner or in allowedUsers
      allow read: if isAuthenticated() && 
        (isOwner(resource.data.ownerId) || isAllowedUser(resource.data.allowedUsers));
      
      // Allow create with valid data
      allow create: if isAuthenticated() &&
        request.resource.data.ownerId == request.auth.uid &&
        request.auth.uid in request.resource.data.allowedUsers &&
        isValidString(request.resource.data.name, 1, 100);
      
      // Allow update if user is owner or in allowedUsers
      allow update: if isAuthenticated() && 
        (isOwner(resource.data.ownerId) || isAllowedUser(resource.data.allowedUsers)) &&
        // Prevent changing ownership
        request.resource.data.ownerId == resource.data.ownerId &&
        isValidString(request.resource.data.name, 1, 100);
      
      // Only owner can delete
      allow delete: if isOwner(resource.data.ownerId);
      
      // Items subcollection
      match /items/{itemId} {
        // Allow read if user has access to parent list
        allow read: if isAuthenticated() && 
          (isOwner(get(/databases/$(database)/documents/lists/$(listId)).data.ownerId) || 
           isAllowedUser(get(/databases/$(database)/documents/lists/$(listId)).data.allowedUsers));
        
        // Allow create/update if user has access and data is valid
        allow create, update: if isAuthenticated() && 
          (isOwner(get(/databases/$(database)/documents/lists/$(listId)).data.ownerId) || 
           isAllowedUser(get(/databases/$(database)/documents/lists/$(listId)).data.allowedUsers)) &&
          isValidString(request.resource.data.text, 1, 200);
        
        // Allow delete if user has access
        allow delete: if isAuthenticated() && 
          (isOwner(get(/databases/$(database)/documents/lists/$(listId)).data.ownerId) || 
           isAllowedUser(get(/databases/$(database)/documents/lists/$(listId)).data.allowedUsers));
      }
    }
    
    // Share tokens collection
    match /shareTokens/{tokenId} {
      // Anyone authenticated can read tokens (needed for joining)
      allow read: if isAuthenticated();
      
      // Only authenticated users can create tokens
      allow create: if isAuthenticated() && 
        request.resource.data.createdBy == request.auth.uid;
      
      // Token creator can update (for usage count, deactivation)
      allow update: if isAuthenticated() && 
        resource.data.createdBy == request.auth.uid;
      
      // Token creator can delete
      allow delete: if isAuthenticated() && 
        resource.data.createdBy == request.auth.uid;
    }
    
    // List members collection
    match /listMembers/{memberId} {
      // Members can read their own membership
      allow read: if isAuthenticated() && 
        resource.data.userId == request.auth.uid;
      
      // Allow creating membership via token join
      allow create: if isAuthenticated() && 
        request.resource.data.userId == request.auth.uid;
      
      // List owner can update/delete members
      allow update, delete: if isAuthenticated() && 
        isOwner(get(/databases/$(database)/documents/lists/$(resource.data.listId)).data.ownerId);
    }
    
    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
